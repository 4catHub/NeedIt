# Default: clearly labelled preview. Mock never calculates a refund.
NEXT_PUBLIC_NEEDIT_API_MODE=mock
NEXT_PUBLIC_NEEDIT_API_BASE_URL=
# Set only after replacing the preview OpenAPI with the verified backend contract.
NEXT_PUBLIC_NEEDIT_CONTRACT_VERIFIED=false
# Public deployment origin (no trailing slash). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
