{
  "name": "needit-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node scripts/production-smoke.mjs",
    "api:generate": "openapi-typescript contracts/tax-preview.openapi.json -o src/types/tax-preview.generated.ts",
    "api:check": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.6.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0",
    "openapi-typescript": "^7.10.0"
  }
}
